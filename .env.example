ENVIRONMENT=development

# Usadas pelo app (DATABASE_URL) e pelo docker-compose.yml (para inicializar o container do Postgres)
POSTGRES_USER=fono
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fono

DATABASE_URL=postgresql+asyncpg://fono:changeme@localhost:5433/fono

JWT_SECRET=changeme
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:5173

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fono-anexos
MINIO_SECURE=false

REDIS_URL=redis://localhost:6379/0

# "placeholder" (padrao, sem IA) | "openai" (exige OPENAI_API_KEY preenchida)
AI_GATEWAY_MODO=placeholder
OPENAI_API_KEY=
